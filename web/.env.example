# Data source: "engine" (default; custodial off-chain exchange, docs/ENGINE_API.md), "mock", or "contracts" (legacy)
VITE_BACKEND=engine
# Engine REST + WebSocket base URL (the /ws path is derived from it). Local stub: node dev/stub-engine.mjs
VITE_ENGINE_URL=http://127.0.0.1:8787

# ---- legacy on-chain source only (VITE_BACKEND=contracts) ----
# 31337 = local Hardhat node, 97 = BNB Smart Chain testnet, 56 = BNB Smart Chain mainnet.
# Any other id is treated as a custom demo chain: VITE_CHAIN_NAME + VITE_RPC_URL are used as given (native currency ETH).
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
# VITE_CHAIN_NAME=Stoxhome Demo
# VITE_EXPLORER_URL=
# Indexer API (REST + /ws)
VITE_API_URL=http://127.0.0.1:4000
# Optional hosted faucet: POST {address} -> {gas, usdt, txs} | {error} (429 = cooldown). Unset = MockUSDT.mint when deployment.mockUsdt
# VITE_FAUCET_URL=
