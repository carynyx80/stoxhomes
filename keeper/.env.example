# --- required ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Keeper EOA. Must be an oracle keeper (oracle.setKeeper) to publish prints. Never commit a real key.
KEEPER_PRIVATE_KEY=
# --- loop ---
POLL_MS=3000
START_BLOCK=0
DRY_RUN=true
LOG_CHUNK=5000
HEALTH_PORT=4100
# --- addresses (default: read from ../web/src/contracts/deployments.json by CHAIN_ID) ---
# EXCHANGE_ADDRESS=0x...
# ORACLE_ADDRESS=0x...          (default: exchange.oracle())
# DEPLOYMENTS_FILE=../web/src/contracts/deployments.json
# ARTIFACTS_DIR=../contracts/artifacts/contracts
# --- liquidator ---
LIQ_CONCURRENCY=4
# GAS_PRICE_GWEI=3              (legacy gasPrice override; BSC uses legacy pricing)
# MAX_GAS_PRICE_GWEI=20         (skip sends while network gas price is above this)
# GAS_LIMIT=500000
# --- publisher ---
PRICE_SOURCE=file               # file | http
PRICES_FILE=data/index-prints.json   # .json [{symbol,date,value}] or .csv symbol,date,value
# PRICE_HTTP_URL=https://provider.example/v1/indices
# PRICE_HTTP_TOKEN=
PUBLISH_EVERY_MS=60000
# PUBLISHER_STATE_FILE=data/.publisher-state.json
# Optional [{symbol, releaseAt: ISO}] -> oracle.schedulePrint for the next release (close-only window)
RELEASE_CALENDAR_FILE=data/release-calendar.json
