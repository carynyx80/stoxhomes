# --- chain selection --------------------------------------------------------
# solana (default) or evm (legacy BNB Chain adapter)
CHAIN=solana

# --- required ---------------------------------------------------------------
# HMAC key for session tokens (>= 16 chars; use 32+ random bytes, e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# --- runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=4000
# SQLite file; on Railway mount a volume at /data
DB_PATH=/data/engine.db
# Background loop period (funding accrual, liquidations, snapshots, ws broadcast)
LOOP_MS=2000
# Set to 0 to disable the chain watcher (local dev without RPC)
WATCHER=1

# --- Solana -------------------------------------------------------------------
# Comma-separated, tried in order. publicnode first; api.mainnet-beta rate-limits hard (last resort).
RPC_URL=https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
COMPANY_ADDRESS=8oYH186qjPyYwnS58fh1NH1m5iFFJe8wPnBKVp3NGtgx
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# Optional: scan the company ATA history newer than this signature. Empty = start from now (no old history).
START_SIGNATURE=
# Optional per-mint overrides (a signature from that ATA's own history)
START_SIGNATURE_USDC=
START_SIGNATURE_USDT=
POLL_MS=10000
MAX_TX_PER_POLL=200
BLOCKHASH_CACHE_MS=5000

# --- EVM (only when CHAIN=evm) -----------------------------------------------
# RPC_URL=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.defibit.io
# CHAIN_ID=56
# USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# USDT_DECIMALS=18
# COMPANY_ADDRESS=0x106342ec570e207afda9fda63125d7a9071127f2
# START_BLOCK=            (required in production)
# CONFIRMATIONS=15
# LOG_CHUNK=2000

# --- markets / practice --------------------------------------------------
# Skew (index units) at which the mark premium reaches 100%
SKEW_SCALE=150000
# Practice mode (separate engine + DB under /practice): 1 on, 0 off
PRACTICE=1
PRACTICE_DB_PATH=/data/practice.db
PRACTICE_VAULT_SEED=10000000
PRACTICE_FAUCET=10000

# --- money limits (USD, decimal) -------------------------------------------
MIN_DEPOSIT=10
MIN_WITHDRAW=10

# --- web / security -------------------------------------------------------
ALLOWED_DOMAIN=www.stoxhome.xyz
CORS_ORIGINS=https://www.stoxhome.xyz,https://stoxhome.xyz
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_ADDR_PER_MIN=60
# Trust the first proxy hop for client IPs (Railway). Set 0 when exposed directly.
TRUST_PROXY=1
