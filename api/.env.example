# JSON-RPC endpoint (local Hardhat: 8545; BNB testnet: https://data-seed-prebsc-1-s1.bnbchain.org:8545)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Default to web/src/contracts/deployments.json[CHAIN_ID] when unset
EXCHANGE_ADDRESS=
ORACLE_ADDRESS=
COLLATERAL_ADDRESS=
# First block to backfill from (set to the exchange deployment block on testnet/mainnet)
START_BLOCK=0
POLL_MS=3000
# Take a market snapshot at least every N blocks (also after any block range with trades)
SNAPSHOT_EVERY=20
# Blocks re-scanned on every poll to handle reorgs
REORG_DEPTH=10
# Max block span per eth_getLogs call
LOG_CHUNK=2000
DB_PATH=./data/housedex.db
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Directory holding *.json ABIs + deployments.json (default ../web/src/contracts)
# ABI_DIR=
